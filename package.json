{
  "name": "course-site",
  "version": "0.1.0",
  "description": "אתר קורס פיתוח Full-Stack — מבוסס על ערכת Doks",
  "author": "Thulite",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thuliteio/doks.git"
  },
  "scripts": {
    "create": ".tools\\hugo.exe new",
    "dev": ".tools\\hugo.exe server --disableFastRender --noHTTPCache",
    "format": "prettier **/** -w -c",
    "build": "if [ \"$VERCEL_ENV\" = \"production\" ] || [ -z \"$VERCEL_URL\" ]; then SITE_BASEURL=\"https://kodkode-fs.nm-ambition.com/\"; else SITE_BASEURL=\"https://$VERCEL_URL/\"; fi && hugo --minify --gc --baseURL \"$SITE_BASEURL\"",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@tabler/icons": "^3.36.1",
    "@thulite/doks-core": "^1.9.3",
    "@thulite/images": "^3.3.4",
    "@thulite/inline-svg": "^1.2.2",
    "@thulite/seo": "^2.4.3",
    "nodemailer": "^9.0.5",
    "thulite": "^2.6.5"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
